# ── Database ──────────────────────────────────────────────────────────────────
MEMLORD_DB_URL=postgresql+asyncpg://postgres:postgres@postgres/memlord

# ── ONNX model ────────────────────────────────────────────────────────────────
# Directory containing model.onnx and tokenizer.json.
MEMLORD_MODEL_DIR=/app/src/memlord/onnx

# Output dimension of the embedding model. Changing it rewrites the embedding
# column on the next `alembic upgrade head`; existing vectors must be rebuilt
# with REEMBED=1.
# MEMLORD_EMBEDDING_DIM=384

# ── Remote embeddings (optional) ──────────────────────────────────────────────
# Set the provider to "http" to call an OpenAI-compatible /v1/embeddings
# endpoint instead of running the bundled ONNX model in-process. Remember to set
# MEMLORD_EMBEDDING_DIM to whatever that model returns.
# MEMLORD_EMBEDDING_PROVIDER=onnx
# MEMLORD_EMBEDDING_URL=http://localhost:8080/v1/embeddings
# MEMLORD_EMBEDDING_MODEL=default
# MEMLORD_EMBEDDING_API_KEY=
# MEMLORD_EMBEDDING_TIMEOUT=30

# ── Server ────────────────────────────────────────────────────────────────────
MEMLORD_HOST=0.0.0.0
MEMLORD_PORT=8000

# ── Search tuning ─────────────────────────────────────────────────────────────
# MEMLORD_RRF_K=60
# MEMLORD_DEFAULT_LIMIT=10
# MEMLORD_SIM_THRESHOLD=0.7
# MEMLORD_DEDUP_THRESHOLD=0.95

# ── OAuth 2.1 ─────────────────────────────────────────────────────────────────
# MEMLORD_BASE_URL=http://localhost:8000
# MEMLORD_OAUTH_JWT_SECRET=change-me-to-a-long-random-secret

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# MEMLORD_SMTP_HOST=smtp.resend.com
# MEMLORD_SMTP_PORT=587
# MEMLORD_SMTP_USER=resend
# MEMLORD_SMTP_PASSWORD=re_xxxxxxxxxxxx
# MEMLORD_SMTP_FROM=noreply@example.com
# MEMLORD_SMTP_TLS=true
